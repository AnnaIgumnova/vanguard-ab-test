.gitignore
# ===============================
# Tableau temporary / backup files
# ===============================
*.twb
*.twbx
*.twbr
.~*

# ===============================
# Jupyter Notebook temp files
# ===============================
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ===============================
# OS junk files
# ===============================
.DS_Store
Thumbs.db

# Keep folder structure but ignore data files
DATA SETS/*
data raw/*
data clean/*

!DATA SETS/.gitkeep
!data raw/.gitkeep
!data clean/.gitkeep
# Ignore data folders
DATA SETS/*
data raw/*
data clean/*

# Keep folder structure
!DATA SETS/.gitkeep
!data raw/.gitkeep
!data clean/.gitkeep

# Ignore notebooks
*.ipynb

# Ignore Tableau temp / working files
*.twb
*.twbr
.~*